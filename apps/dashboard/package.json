{
	"$schema": "https://json.schemastore.org/package.json",
	"name": "mamacord-dashboard",
	"private": true,
	"version": "0.1.0",
	"type": "module",
	"scripts": {
		"dev": "vite --mode dev",
		"build": "tsc --noEmit && vite build --mode prod",
		"preview": "vite preview",
		"typecheck": "bunx tsc --noEmit",
		"biome:check": "bunx biome@latest check . --write --max-diagnostics 16384",
		"biome:format": "bunx biome@latest format . --write --max-diagnostics 16384",
		"biome:lint": "bunx biome@latest lint . --write --max-diagnostics 16384"
	},
	"dependencies": {
		"@mantine/core": "^9.5.1",
		"@mantine/hooks": "^9.5.1",
		"@mantine/notifications": "^9.5.1",
		"@mamacord/web-ui": "workspace:*",
		"@tabler/icons-react": "^3.46.0",
		"react": "^19.2.8",
		"react-dom": "^19.2.8"
	},
	"devDependencies": {
		"@types/bun": "^1.3.14",
		"@types/react": "^19.2.18",
		"@types/react-dom": "^19.2.4",
		"@vitejs/plugin-react": "^6.0.5",
		"bun-types": "^1.3.14",
		"typescript": "^7.0.2",
		"vite": "^8.2.1"
	}
}
