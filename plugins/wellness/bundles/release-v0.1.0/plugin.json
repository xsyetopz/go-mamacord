{
	"$schema": "https://raw.githubusercontent.com/xsyetopz/go-mamacord/refs/heads/main/schemas/plugin.schema.json",
	"id": "wellness",
	"name": "Wellness",
	"version": "0.1.0",
	"entrypoint": "plugin.star",
	"permissions": {
		"storage": {
			"kv": true,
			"user_settings": true,
			"checkins": true,
			"reminders": true,
			"warnings": false,
			"audit": false
		},
		"discord": {
			"users": false,
			"guilds": false,
			"channels": false,
			"messages": false,
			"reactions": false,
			"members": false,
			"roles": false,
			"threads": false,
			"invites": false,
			"webhooks": false,
			"emojis": false,
			"stickers": false
		},
		"network": {
			"http": false,
			"hosts": []
		},
		"resources": {
			"read": false
		},
		"automation": {
			"jobs": false,
			"events": {
				"member_join_leave": false,
				"moderation": false
			}
		}
	},
	"locales": {
		"default": "en-US",
		"supported": [
			"bg",
			"cs",
			"da",
			"de",
			"el",
			"en-GB",
			"en-US",
			"es-419",
			"es-ES",
			"fi",
			"fr",
			"hi",
			"hr",
			"hu",
			"id",
			"it",
			"ja",
			"ko",
			"lt",
			"nl",
			"no",
			"pl",
			"pt-BR",
			"ro",
			"ru",
			"sv-SE",
			"th",
			"tr",
			"uk",
			"vi",
			"zh-CN",
			"zh-TW"
		]
	},
	"assets": [],
	"state_keys": ["guild_config"]
}
